# Settings for an exam station (docker-compose.station.yml).
# Copy this file to station.env and fill in every value. Keep station.env off
# shared drives: the station key unlocks results and the invigilation board.

# A long random password for the station's own database. Nobody types it.
STATION_DB_PASSWORD=

# A long random string. Nobody types it.
STATION_SECRET_KEY=

# What staff type to load papers, watch the exam and save results.
# At least 12 characters; a station with a shorter key accepts none.
CBT_STATION_KEY=

# The port students' browsers use. 80 means http://<address>/station works as is.
STATION_PORT=80
